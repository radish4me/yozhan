# Copy this file to .env and fill in what you have. Nothing here is required
# to run the local-only smoke test (Phase 1) — only LOCAL_DEFAULT_MODEL matters
# for that, and it already has a sane default below.

# ---- Local inference (llama.cpp) ----
LOCAL_DEFAULT_MODEL=qwen3.5-0.8b   # one of: qwen3.5-0.8b, lfm2.5, agents-a1-4b
LLAMA_CACHE=/models
HF_TOKEN=
MODEL_ENDPOINT=

# ---- Remote providers (optional, all support multiple numbered keys) ----
ANTHROPIC_API_KEY_1=
ANTHROPIC_API_KEY_2=

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

OPENROUTER_API_KEY=

GROK_API_KEY=

OPENAI_API_KEY=

# ---- Gateway ----
GATEWAY_PORT=3000
TELEGRAM_BOT_TOKEN=
