# Copy this file to .env and fill in what you have. Nothing here is required
# to run the local-only smoke test (Phase 1) — only LOCAL_DEFAULT_MODEL matters
# for that, and it already has a sane default below.

# ---- Local inference (llama.cpp) ----
LOCAL_DEFAULT_MODEL=qwen3.5-0.8b   # one of: qwen3.5-0.8b, lfm2.5, agents-a1-4b
LLAMA_CACHE=/models
HF_TOKEN=
MODEL_ENDPOINT=

# ---- Remote providers (optional, all support multiple numbered keys) ----
ANTHROPIC_API_KEY_1=
ANTHROPIC_API_KEY_2=

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

OPENROUTER_API_KEY=

GROK_API_KEY=

OPENAI_API_KEY=

# ---- Gateway ----
GATEWAY_PORT=3000
# Shared secret for the admin-only /pairing/* endpoints and pairing-cli
# (npm run pairing --prefix gateway -- list|approve). Required to approve
# pairing requests; leave unset only if you don't plan to use any channels yet.
GATEWAY_ADMIN_TOKEN=
# Channels — each is enabled only when its token(s) are set.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
# Slack needs both: an app-level token (xapp-…, connections:write) for Socket
# Mode and a bot token (xoxb-…) to post.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
